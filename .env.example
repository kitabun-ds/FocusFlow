# Use the Supabase project URL and publishable key from Project Settings > API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Keep server-side only. This is used for duplicate-email checks and other
# privileged Supabase admin calls. Never expose it to the browser or frontend.
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_only_on_server

# Generate a long random value and keep it private. Never use a Supabase
# secret/service-role key in the browser or as this Flask session key.
FOCUSFLOW_SECRET_KEY=replace_with_a_long_random_value

# Local app base URL used for Supabase email/auth redirect callbacks.
FOCUSFLOW_BASE_URL=http://127.0.0.1:5000

# Set to 1 when served over HTTPS in production. Keep 0 for local HTTP.
FOCUSFLOW_COOKIE_SECURE=0
